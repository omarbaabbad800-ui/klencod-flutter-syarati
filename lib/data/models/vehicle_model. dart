import '../../domain/entities/vehicle.dart';

class VehicleModel extends Vehicle {
  const VehicleModel({
    required super.id,
    required super.make,
    required super.model,
    required super.year,
    required super.dailyPrice,
    required super.city,
    required super.seats,
    super.isActive,
  });

  factory VehicleModel.fromJson(Map<dynamic, dynamic> json) {
    return VehicleModel(
      id: json['id']?.toString() ?? '',
      make: json['make']?.toString() ?? '',
      model: json['model']?.toString() ?? '',
      year: int.tryParse(json['year']?.toString() ?? '') ?? 2023,
      dailyPrice: double.tryParse(json['dailyPrice']?.toString() ?? '') ?? 0.0,
      city: json['city']?.toString() ?? '',
      seats: int.tryParse(json['seats']?.toString() ?? '') ?? 4,
      isActive: json['isActive'] as bool? ?? true,
    );
  }
}